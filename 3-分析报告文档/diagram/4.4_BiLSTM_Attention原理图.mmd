%%{init: {"theme":"base", "themeVariables": {"fontSize":"18px", "primaryTextColor":"#000000"}}}%%
flowchart TD
    subgraph IN["① 输入序列"]
        x["历史负荷序列 + 特征<br/>（24h 预测窗口前后两侧信息）"]
    end

    subgraph ENC["② BiLSTM 双向编码"]
        direction LR
        fwd["前向 LSTM<br/>捕捉历史→当前"]
        bwd["反向 LSTM<br/>捕捉未来→当前"]
        fwd ~~~ bwd
    end

    subgraph ATT["③ 自注意力机制"]
        att["自注意力<br/>自动学习历史序列中<br/>哪些时刻对预测最重要"]
        vis["注意力权重可视化<br/>（可解释性亮点）"]
        att --> vis
    end

    subgraph TFT["④ TFT（创新加分项）"]
        direction LR
        vsn["变量选择网络<br/>自动识别重要特征"]
        quant["分位数输出<br/>提供预测不确定性区间"]
        vsn ~~~ quant
    end

    IN --> ENC --> ATT --> TFT

    subgraph OUT["⑤ 输出"]
        out["24h 逐时负荷预测<br/>+ 不确定性区间"]
    end

    TFT --> OUT

    subgraph ISSUE["当前状态"]
        issue["BiLSTM 首轮训练归一化层反算问题<br/>MAPE 43%（异常）· 修复中"]
    end

    OUT -.-> ISSUE

    classDef input fill:#f2f2f2,stroke:#333,stroke-width:1.5px,color:#000
    classDef enc fill:#e6e6fa,stroke:#4a3aa7,stroke-width:1.5px,color:#1f1f7a
    classDef att fill:#d9e8f5,stroke:#1f4e79,stroke-width:1.5px,color:#1f4e79
    classDef tft fill:#e8f5e9,stroke:#1b5e20,stroke-width:1.5px,color:#1b5e20
    classDef out fill:#fff3cd,stroke:#997404,stroke-width:2px,color:#5c4a00
    classDef issue fill:#ffe0e0,stroke:#c0392b,stroke-width:2px,color:#8b0000

    class x input
    class fwd,bwd enc
    class att,vis att
    class vsn,quant tft
    class out out
    class issue issue
